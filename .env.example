APP_ENV=development
APP_PORT=8080
APP_NAME=undangan-ariana-adrian

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=undangan_ariana_adrian_db
# Go DSN (database/sql + MySQL driver) — no scheme prefix
DB_DSN=root:@tcp(localhost:3306)/undangan_ariana_adrian_db

JWT_SECRET=change-me
JWT_EXPIRES_IN=24h

# Production build directory of the frontend (both index.html and
# admin.html — PLAN.md decision #10), served by the container.
# Left empty in dev — the frontend is served by Vite instead.
PUBLIC_DIR=

# IDCloudHost Object Storage (S3-compatible) — foto/musik konten yang
# diunggah admin (PLAN.md decision #12, dipindah dari disk lokal/UPLOADS_DIR —
# docs/plan/content-uploads-object-storage/PLAN.md). Bucket dipakai bersama
# aplikasi lain di akun ini (elcodelabs) — JANGAN hapus prefix "elwedding/"
# dari key manapun.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true

# WhatsApp session store (dashboard-wa-rsvp decision #5) — a SQLite file
# created by go.mau.fi/whatsmeow itself, NOT MySQL (the library only fully
# supports SQLite/Postgres). Must persist — if lost, re-pair WhatsApp by
# scanning a new QR code from the admin WhatsApp menu.
WA_STORE_DIR=./wa-store

# Left empty so the frontend uses the same origin (see the Vite proxy in vite.config.ts).
# Only set this when web and api are actually deployed separately.
VITE_API_BASE_URL=
